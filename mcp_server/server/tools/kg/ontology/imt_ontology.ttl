@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix imt:   <http://imt-mines-ales.fr/ontology#> .
@prefix imtd:  <http://imt-mines-ales.fr/data#> .

# ============================================================
# ONTOLOGY METADATA
# ============================================================

<http://imt-mines-ales.fr/ontology>
    a owl:Ontology ;
    rdfs:label "IMT Mines Alès Academic Ontology"@en ,
               "Ontologie Académique IMT Mines Alès"@fr ;
    rdfs:comment "Formal OWL ontology for representing academic course information at IMT Mines Alès, covering all engineering programs (2IA, PRISM, GC, I2ER, ISERM, TC). Grounded in the Syllabus Formations Ingénieur document structure."@en ;
    owl:versionInfo "1.0.0" .


# ============================================================
# CLASSES — Teaching Units
# ============================================================

imt:TeachingUnit a owl:Class ;
    rdfs:label "Teaching Unit"@en , "Unité d'Enseignement"@fr ;
    rdfs:comment "Abstract base class for any academic teaching unit at IMT Mines Alès."@en .

imt:Module a owl:Class ;
    rdfs:subClassOf imt:TeachingUnit ;
    rdfs:label "Module"@en , "Module / UE"@fr ;
    rdfs:comment "A top-level teaching unit (UE) that may contain multiple courses or sub-elements. Maps to both 'Module' (older 2IA guides) and the UE-level entry in the Syllabus Formations Ingénieur format."@en .

imt:Course a owl:Class ;
    rdfs:subClassOf imt:TeachingUnit ;
    rdfs:label "Course"@en , "Matière / Élément Constitutif"@fr ;
    rdfs:comment "A sub-unit within a Module. Maps to 'Matière' in older guides and 'Élément constitutif de l'UE' in the standard Syllabus format."@en .


# ============================================================
# CLASSES — Academic Structure
# ============================================================

imt:Program a owl:Class ;
    rdfs:label "Program"@en , "Département / Formation"@fr ;
    rdfs:comment "An engineering program at IMT Mines Alès (e.g., 2IA, PRISM, GC, I2ER, ISERM, TC)."@en .

imt:Track a owl:Class ;
    rdfs:label "Track"@en , "Option / Filière"@fr ;
    rdfs:comment "A specialization track within a program (e.g., IASD, IL, IMG within 2IA; gitm, sym within PRISM)."@en .

imt:Semester a owl:Class ;
    rdfs:label "Semester"@en , "Semestre"@fr ;
    rdfs:comment "An academic semester. IMT Mines Alès uses S5–S10 for engineering curriculum."@en .

imt:CompetencyBlock a owl:Class ;
    rdfs:label "Competency Block"@en , "Bloc de Compétences"@fr ;
    rdfs:comment "A competency block (BC) grouping related competencies in the curricular alignment framework."@en .

imt:Competency a owl:Class ;
    rdfs:label "Competency"@en , "Compétence"@fr ;
    rdfs:comment "An individual competency (C) defined within a competency block and addressed by teaching units."@en .


# ============================================================
# CLASSES — People
# ============================================================

imt:Person a owl:Class ;
    rdfs:label "Person"@en , "Personne"@fr .

imt:Professor a owl:Class ;
    rdfs:subClassOf imt:Person ;
    rdfs:label "Professor"@en , "Enseignant"@fr ;
    rdfs:comment "A professor, lecturer, or teaching assistant at IMT Mines Alès."@en .

imt:Laboratory a owl:Class ;
    rdfs:label "Laboratory"@en , "Laboratoire"@fr ;
    rdfs:comment "A research laboratory affiliated with IMT Mines Alès (e.g., LGI2P, LGEI)."@en .


# ============================================================
# CLASSES — Evaluation
# ============================================================

imt:Evaluation a owl:Class ;
    rdfs:label "Evaluation"@en , "Évaluation"@fr ;
    rdfs:comment "An assessment component for a teaching unit, with a type (exam, project, oral) and a coefficient."@en .


# ============================================================
# CLASSES — Documents (FAQ & General)
# ============================================================

imt:Document a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:comment "A general institutional document (brochure, guideline, regulation)."@en .

imt:FAQ a owl:Class ;
    rdfs:subClassOf imt:Document ;
    rdfs:label "FAQ"@en ;
    rdfs:comment "A Frequently Asked Questions document about school life, procedures, or contracts."@en .

imt:FAQEntry a owl:Class ;
    rdfs:label "FAQ Entry"@en ;
    rdfs:comment "A single question–answer pair within a FAQ document."@en .


# ============================================================
# OBJECT PROPERTIES — Teaching Unit Relations
# ============================================================

imt:hasCourse a owl:ObjectProperty ;
    rdfs:domain imt:Module ;
    rdfs:range  imt:Course ;
    rdfs:label  "hasCourse"@en ;
    rdfs:comment "A Module contains one or more Courses (matières / éléments constitutifs)."@en .

imt:hasEvaluation a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Evaluation ;
    rdfs:label  "hasEvaluation"@en ;
    rdfs:comment "A teaching unit is assessed by one or more evaluations."@en .

imt:taughtBy a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Professor ;
    rdfs:label  "taughtBy"@en ;
    rdfs:comment "A teaching unit is taught by a professor."@en .

imt:responsibleProfessor a owl:ObjectProperty ;
    rdfs:subPropertyOf imt:taughtBy ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Professor ;
    rdfs:label  "responsibleProfessor"@en ;
    rdfs:comment "The designated responsible professor (Responsable) of a teaching unit."@en .

imt:partOfProgram a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Program ;
    rdfs:label  "partOfProgram"@en ;
    rdfs:comment "This teaching unit belongs to an academic program."@en .

imt:partOfTrack a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Track ;
    rdfs:label  "partOfTrack"@en ;
    rdfs:comment "This teaching unit is specific to a specialization track."@en .

imt:inSemester a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Semester ;
    rdfs:label  "inSemester"@en ;
    rdfs:comment "The semester in which this teaching unit is delivered."@en .

imt:hasPrerequisite a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:TeachingUnit ;
    rdfs:label  "hasPrerequisite"@en ;
    rdfs:comment "This teaching unit requires the linked unit as a prerequisite."@en .

imt:addressesCompetency a owl:ObjectProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  imt:Competency ;
    rdfs:label  "addressesCompetency"@en ;
    rdfs:comment "The teaching unit contributes to this competency."@en .

imt:partOfModule a owl:ObjectProperty ;
    owl:inverseOf imt:hasCourse ;
    rdfs:domain imt:Course ;
    rdfs:range  imt:Module ;
    rdfs:label  "partOfModule"@en ;
    rdfs:comment "This course belongs to the linked module."@en .


# ============================================================
# OBJECT PROPERTIES — Program / Track / Competency Structure
# ============================================================

imt:trackBelongsToProgram a owl:ObjectProperty ;
    rdfs:domain imt:Track ;
    rdfs:range  imt:Program ;
    rdfs:label  "trackBelongsToProgram"@en .

imt:competencyInBlock a owl:ObjectProperty ;
    rdfs:domain imt:Competency ;
    rdfs:range  imt:CompetencyBlock ;
    rdfs:label  "competencyInBlock"@en ;
    rdfs:comment "This competency belongs to a competency block."@en .

imt:blockBelongsToProgram a owl:ObjectProperty ;
    rdfs:domain imt:CompetencyBlock ;
    rdfs:range  imt:Program ;
    rdfs:label  "blockBelongsToProgram"@en .


# ============================================================
# OBJECT PROPERTIES — People / Infrastructure
# ============================================================

imt:affiliatedTo a owl:ObjectProperty ;
    rdfs:domain imt:Professor ;
    rdfs:range  imt:Laboratory ;
    rdfs:label  "affiliatedTo"@en ;
    rdfs:comment "The professor is affiliated with this research laboratory."@en .


# ============================================================
# OBJECT PROPERTIES — FAQ
# ============================================================

imt:hasFAQEntry a owl:ObjectProperty ;
    rdfs:domain imt:FAQ ;
    rdfs:range  imt:FAQEntry ;
    rdfs:label  "hasFAQEntry"@en .

imt:aboutProgram a owl:ObjectProperty ;
    rdfs:domain imt:FAQ ;
    rdfs:range  imt:Program ;
    rdfs:label  "aboutProgram"@en ;
    rdfs:comment "This FAQ is related to a specific program."@en .


# ============================================================
# DATATYPE PROPERTIES — TeachingUnit (shared)
# ============================================================

imt:unitCode a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "unitCode"@en ;
    rdfs:comment "Official code of the teaching unit (e.g., 2IA-iasd-9.6, TC_5_1, GCBDbe_9_3)."@en .

imt:unitName a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "unitName"@en ;
    rdfs:comment "Full name of the teaching unit (in French, as it appears in official documents)."@en .

imt:unitNameEN a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "unitNameEN"@en ;
    rdfs:comment "English name of the teaching unit (if provided in the document)."@en .

imt:ects a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "ects"@en ;
    rdfs:comment "Number of ECTS credits awarded for this teaching unit."@en .

imt:supervisedHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "supervisedHours"@en ;
    rdfs:comment "Total supervised/contact hours (Volume d'heures d'enseignement encadré)."@en .

imt:personalWorkHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "personalWorkHours"@en ;
    rdfs:comment "Estimated personal study hours (Volume d'heures de travail personnel)."@en .

imt:rationale a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "rationale"@en ;
    rdfs:comment "Why this teaching unit exists — context and motivation (Pourquoi cette UE ?)."@en .

imt:objectives a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "objectives"@en ;
    rdfs:comment "Learning objectives / targeted skills (Objectifs pédagogiques / Acquis d'apprentissage visés)."@en .

imt:summary a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "summary"@en ;
    rdfs:comment "Short description or summary of the teaching unit content."@en .

imt:content a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "content"@en ;
    rdfs:comment "Detailed programme and content (Programme et contenu)."@en .

imt:keywords a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "keywords"@en ;
    rdfs:comment "Keywords associated with the teaching unit (Mots-clés)."@en .

imt:prerequisiteText a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "prerequisiteText"@en ;
    rdfs:comment "Free-text description of prerequisites, may include course codes in parentheses."@en .

imt:pedagogicalMethod a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:string ;
    rdfs:label  "pedagogicalMethod"@en ;
    rdfs:comment "Description of teaching methods and organisation (Méthode et organisation pédagogique)."@en .

imt:lectureHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "lectureHours"@en ;
    rdfs:comment "Hours of lecture (Cours magistraux / CM)."@en .

imt:workshopHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "workshopHours"@en ;
    rdfs:comment "Hours of seminars and directed work (TD — Travaux Dirigés)."@en .

imt:labHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "labHours"@en ;
    rdfs:comment "Hours of practical lab sessions (TP — Travaux Pratiques)."@en .

imt:projectHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "projectHours"@en ;
    rdfs:comment "Hours dedicated to project work."@en .

imt:examHours a owl:DatatypeProperty ;
    rdfs:domain imt:TeachingUnit ;
    rdfs:range  xsd:integer ;
    rdfs:label  "examHours"@en ;
    rdfs:comment "Hours allocated to scheduled exams and assessments (Contrôles)."@en .


# ============================================================
# DATATYPE PROPERTIES — Course (sub-unit specific)
# ============================================================

imt:coefficientInModule a owl:DatatypeProperty ;
    rdfs:domain imt:Course ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "coefficientInModule"@en ;
    rdfs:comment "Weight/coefficient of this course within its parent module."@en .


# ============================================================
# DATATYPE PROPERTIES — Evaluation
# ============================================================

imt:evaluationType a owl:DatatypeProperty ;
    rdfs:domain imt:Evaluation ;
    rdfs:range  xsd:string ;
    rdfs:label  "evaluationType"@en ;
    rdfs:comment "Type of evaluation. Known values: devoir_sur_table, projet, exposé_oral, TP_noté, contrôle_surprise, soutenance."@en .

imt:evaluationCoefficient a owl:DatatypeProperty ;
    rdfs:domain imt:Evaluation ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "evaluationCoefficient"@en ;
    rdfs:comment "Numerical weight of this evaluation component."@en .

imt:administrationMode a owl:DatatypeProperty ;
    rdfs:domain imt:Evaluation ;
    rdfs:range  xsd:string ;
    rdfs:label  "administrationMode"@en ;
    rdfs:comment "How the evaluation is administered: individuelle or groupe."@en .

imt:feedbackDelay a owl:DatatypeProperty ;
    rdfs:domain imt:Evaluation ;
    rdfs:range  xsd:string ;
    rdfs:label  "feedbackDelay"@en ;
    rdfs:comment "Time limit for returning graded work to students (e.g., '3 semaines')."@en .

imt:indicatorsEvaluated a owl:DatatypeProperty ;
    rdfs:domain imt:Evaluation ;
    rdfs:range  xsd:string ;
    rdfs:label  "indicatorsEvaluated"@en ;
    rdfs:comment "Competency indicators evaluated by this assessment (e.g., '1, 2, 3')."@en .


# ============================================================
# DATATYPE PROPERTIES — Professor
# ============================================================

imt:personName a owl:DatatypeProperty ;
    rdfs:domain imt:Person ;
    rdfs:range  xsd:string ;
    rdfs:label  "personName"@en ;
    rdfs:comment "Full name of the person (LAST First format as in official documents)."@en .

imt:email a owl:DatatypeProperty ;
    rdfs:domain imt:Person ;
    rdfs:range  xsd:string ;
    rdfs:label  "email"@en .

imt:phone a owl:DatatypeProperty ;
    rdfs:domain imt:Person ;
    rdfs:range  xsd:string ;
    rdfs:label  "phone"@en .

imt:expertise a owl:DatatypeProperty ;
    rdfs:domain imt:Professor ;
    rdfs:range  xsd:string ;
    rdfs:label  "expertise"@en ;
    rdfs:comment "Research and teaching expertise domain of the professor."@en .


# ============================================================
# DATATYPE PROPERTIES — Laboratory
# ============================================================

imt:labCode a owl:DatatypeProperty ;
    rdfs:domain imt:Laboratory ;
    rdfs:range  xsd:string ;
    rdfs:label  "labCode"@en ;
    rdfs:comment "Short code of the laboratory (e.g., LGI2P, LGEI, CHROME)."@en .

imt:labName a owl:DatatypeProperty ;
    rdfs:domain imt:Laboratory ;
    rdfs:range  xsd:string ;
    rdfs:label  "labName"@en ;
    rdfs:comment "Full name of the laboratory."@en .


# ============================================================
# DATATYPE PROPERTIES — Program & Track
# ============================================================

imt:programCode a owl:DatatypeProperty ;
    rdfs:domain imt:Program ;
    rdfs:range  xsd:string ;
    rdfs:label  "programCode"@en ;
    rdfs:comment "Short code of the program (e.g., 2IA, PRISM, GC, I2ER, ISERM, TC)."@en .

imt:programName a owl:DatatypeProperty ;
    rdfs:domain imt:Program ;
    rdfs:range  xsd:string ;
    rdfs:label  "programName"@en ;
    rdfs:comment "Full name of the engineering program."@en .

imt:programNameEN a owl:DatatypeProperty ;
    rdfs:domain imt:Program ;
    rdfs:range  xsd:string ;
    rdfs:label  "programNameEN"@en .

imt:trackCode a owl:DatatypeProperty ;
    rdfs:domain imt:Track ;
    rdfs:range  xsd:string ;
    rdfs:label  "trackCode"@en ;
    rdfs:comment "Short code of the specialization track (e.g., iasd, il, img, gitm, sym, be, igo, ee, risk)."@en .

imt:trackName a owl:DatatypeProperty ;
    rdfs:domain imt:Track ;
    rdfs:range  xsd:string ;
    rdfs:label  "trackName"@en ;
    rdfs:comment "Full name of the specialization track."@en .


# ============================================================
# DATATYPE PROPERTIES — Semester
# ============================================================

imt:semesterCode a owl:DatatypeProperty ;
    rdfs:domain imt:Semester ;
    rdfs:range  xsd:string ;
    rdfs:label  "semesterCode"@en ;
    rdfs:comment "Semester identifier (S5, S6, S8, S9, S10)."@en .

imt:academicYear a owl:DatatypeProperty ;
    rdfs:domain imt:Semester ;
    rdfs:range  xsd:string ;
    rdfs:label  "academicYear"@en ;
    rdfs:comment "Academic year of the syllabus (e.g., 2024-2025)."@en .


# ============================================================
# DATATYPE PROPERTIES — CompetencyBlock & Competency
# ============================================================

imt:blockCode a owl:DatatypeProperty ;
    rdfs:domain imt:CompetencyBlock ;
    rdfs:range  xsd:string ;
    rdfs:label  "blockCode"@en ;
    rdfs:comment "Code of the competency block (e.g., BC1, FIG-BC01, FIG-BC08)."@en .

imt:blockName a owl:DatatypeProperty ;
    rdfs:domain imt:CompetencyBlock ;
    rdfs:range  xsd:string ;
    rdfs:label  "blockName"@en ;
    rdfs:comment "Human-readable name of the competency block."@en .

imt:competencyCode a owl:DatatypeProperty ;
    rdfs:domain imt:Competency ;
    rdfs:range  xsd:string ;
    rdfs:label  "competencyCode"@en ;
    rdfs:comment "Competency identifier within its block (e.g., C1, C2, C3)."@en .

imt:competencyLevel a owl:DatatypeProperty ;
    rdfs:domain imt:Competency ;
    rdfs:range  xsd:string ;
    rdfs:label  "competencyLevel"@en ;
    rdfs:comment "How the competency is addressed. Values: non_adressee | mise_en_oeuvre | enseignee | evaluee | enseignee_et_evaluee."@en .


# ============================================================
# DATATYPE PROPERTIES — FAQ
# ============================================================

imt:question a owl:DatatypeProperty ;
    rdfs:domain imt:FAQEntry ;
    rdfs:range  xsd:string ;
    rdfs:label  "question"@en .

imt:answer a owl:DatatypeProperty ;
    rdfs:domain imt:FAQEntry ;
    rdfs:range  xsd:string ;
    rdfs:label  "answer"@en .

imt:faqTopic a owl:DatatypeProperty ;
    rdfs:domain imt:FAQ ;
    rdfs:range  xsd:string ;
    rdfs:label  "faqTopic"@en ;
    rdfs:comment "Topic area of the FAQ (e.g., school_life, housing, contracts, procedures)."@en .


